# ACS Server — Docker Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────────
# PUBLIC URL
# The URL where your ACS server will be accessible from the internet
# (or your local network). This is used to build the ACS provisioning
# URLs shown to routers/CPE devices.
# Examples:
#   http://192.168.1.100
#   http://acs.myisp.com
#   https://acs.myisp.com   ← if you put a TLS terminator in front
# ─────────────────────────────────────────────────────────────────
ACS_PUBLIC_URL=http://your-server-ip-or-domain

# ─────────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────────
DB_NAME=acs_server_db
# MONGO_PORT=27017    # change only if host port 27017 is occupied

# ─────────────────────────────────────────────────────────────────
# SECURITY
# Generate a strong secret with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-in-production-use-a-long-random-string

# ─────────────────────────────────────────────────────────────────
# INITIAL SUPER ADMIN CREDENTIALS
# These are used only on first startup to seed the admin account.
# Change the password immediately after first login.
# ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@acsserver.com
ADMIN_PASSWORD=Admin@123

# ─────────────────────────────────────────────────────────────────
# AI DIAGNOSTICS (Optional)
# Leave empty to use the built-in Emergent Universal Key.
# Or get your own key from https://aistudio.google.com/
# ─────────────────────────────────────────────────────────────────
EMERGENT_LLM_KEY=

# ─────────────────────────────────────────────────────────────────
# PORT MAPPING (Optional — change only if defaults conflict)
# ─────────────────────────────────────────────────────────────────
HTTP_PORT=80
BACKEND_PORT=8001

# ─────────────────────────────────────────────────────────────────
# CORS (leave * for single-server deployments)
# ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=*
